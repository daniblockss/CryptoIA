# Firebase Realtime Database URL (public endpoint, not an admin credential)
FIREBASE_DATABASE_URL=https://cryptoai-160f4-default-rtdb.firebaseio.com

# Path to a Firebase service-account JSON stored OUTSIDE the repository
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Stable, unique name for this machine/server
SERVER_ID=change-this-to-a-unique-server-id

# Lease coordination
LEASE_TTL_SECONDS=45
HEARTBEAT_INTERVAL_SECONDS=10

# Agent behavior
AGENT_RESTART_DELAY_SECONDS=5
