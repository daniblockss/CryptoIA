FIREBASE_DATABASE_URL=https://cryptoai-160f4-default-rtdb.firebaseio.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
SERVER_ID=change-this-to-a-unique-server-id
LEASE_TTL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=10

# LLM7 (optional until you add your own token)
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=DeepSeek-V4.1-Flash
LLM7_MAX_CALLS_PER_DAY=8
LLM7_MIN_INTERVAL_SECONDS=300
LLM7_MAX_TOKENS=700
LLM7_MAX_TOKENS_PER_DAY=12000

# Public market data
CMC_API_KEY=
MARKET_REFRESH_SECONDS=90
MARKET_ASSETS=BTC,ETH,SOL
INITIAL_SIMULATED_BRL=10.00
SIMULATED_PIX_FEE_BRL=2.99
LOG_LEVEL=INFO
